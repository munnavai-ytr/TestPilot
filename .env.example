# ==============================================================================
# TestPilot Runner: Environment Configuration
# ==============================================================================

# 1. Runner Access Token (Required)
# A secure random secret used by the TestPilot web app to authenticate API requests.
# Generate any long random string (e.g. openssl rand -hex 24)
RUNNER_TOKEN="tp_live_secret_token_change_me_in_production"

# 2. Supabase Configuration (Required for persistent run storage and screenshots)
# Found in Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Service Role Secret Key (Required: bypasses RLS to read/write runs table and upload screenshots)
# NOTE: Never expose this key in public client apps!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
# Controls which Gemini model powers the QA vision agent
GEMINI_MODEL="gemini-2.5-flash"

# 4. CORS Allowed Origin (Optional, defaults to * or your frontend domain)
# Example: https://my-testpilot-app.vercel.app or *
ALLOWED_ORIGIN="*"

# 5. Server Port (Optional, defaults to 7860 on Hugging Face Spaces or 3000 locally)
PORT=7860
